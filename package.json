{
  "name": "@niyantra/commerce",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript SDK for Niyantra Commerce",
  "author": "Niyantra Labs",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Niyantra-Labs/commerce-tssdk.git"
  },
  "homepage": "https://github.com/Niyantra-Labs/commerce-tssdk",
  "bugs": "https://github.com/Niyantra-Labs/commerce-tssdk/issues",
  "keywords": [
    "niyantra",
    "commerce",
    "licensing",
    "sdk"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:integration": "npm run build && node integration/live-smoke.mjs",
    "fmt": "prettier --write src test examples integration README.md doc package.json",
    "fmt:check": "prettier --check src test examples integration README.md doc package.json",
    "lint": "eslint . --max-warnings 0",
    "docs": "typedoc --out .typedoc src/index.ts",
    "audit": "npm audit --omit=dev",
    "contract:manifest": "python3 -I scripts/route-manifest.py ${COMMERCE_REPO:-../commerce} > test/fixtures/routes.json",
    "contract:check": "python3 -I scripts/route-manifest.py ${COMMERCE_REPO:-../commerce} | diff -u test/fixtures/routes.json - && echo \"route manifest matches the server\"",
    "test:runtimes": "npm run build && node integration/runtime-smoke.mjs",
    "test:package": "npm run build && node integration/package-smoke.mjs",
    "test:bundle": "node scripts/check-bundle.mjs",
    "test:api": "npm run build && api-extractor run --local"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@microsoft/api-extractor": "7.59.4",
    "@types/express": "5.0.6",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "4.1.11",
    "ajv": "8.20.0",
    "esbuild": "0.25.12",
    "eslint": "^9.0.0",
    "expect-type": "1.2.2",
    "msw": "2.15.0",
    "prettier": "^3.0.0",
    "typedoc": "^0.28.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.4.5",
    "vitest": "4.1.11"
  }
}
