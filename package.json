{
  "name": "@niyantra/commerce",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript SDK for Niyantra Commerce",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Niyantra-Labs/commerce-tssdk.git"
  },
  "homepage": "https://github.com/Niyantra-Labs/commerce-tssdk",
  "bugs": "https://github.com/Niyantra-Labs/commerce-tssdk/issues",
  "keywords": [
    "niyantra",
    "commerce",
    "licensing",
    "sdk"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fmt": "prettier --write src test examples README.md doc package.json",
    "fmt:check": "prettier --check src test examples README.md doc package.json",
    "lint": "eslint .",
    "docs": "typedoc --out dist/docs src/index.ts",
    "audit": "npm audit --omit=dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typedoc": "^0.28.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  }
}
